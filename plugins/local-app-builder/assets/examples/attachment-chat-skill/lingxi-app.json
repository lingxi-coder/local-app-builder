{
  "schema": 2,
  "name": "Attachment Review Chat",
  "summary": "Keep a durable review conversation with user-selected file attachments.",
  "entry": { "type": "static", "path": "index.html" },
  "capabilities": ["agent"],
  "agent": {
    "tools": [],
    "skills": [{ "id": "review", "path": "skills/review/SKILL.md" }]
  },
  "targets": [
    { "platform": "android", "environment": "web" },
    { "platform": "ios", "environment": "web" },
    { "platform": "macos", "environment": "web" },
    { "platform": "windows", "environment": "web" },
    { "platform": "linux", "environment": "web" },
    { "platform": "web", "environment": "web" }
  ],
  "package": {
    "files": ["index.html", "styles.css", "app.mjs", "skills/review/SKILL.md"],
    "dependencyLocks": []
  },
  "dataSchema": { "version": 1, "compatibleFrom": 1 }
}
