{
  "description": "A legacy (2025-11-25) client: initialize, notifications/initialized, then requests that carry no version. Written from the revision's published lifecycle, not captured from a client.",
  "client": {
    "name": "SpecExample",
    "version": "2025-11-25",
    "protocol": "2025-11-25"
  },
  "steps": [
    {
      "send": {
        "jsonrpc": "2.0",
        "id": 1,
        "method": "tools/list"
      },
      "expect": {
        "id": 1,
        "error": {
          "code": -32600
        }
      }
    },
    {
      "send": {
        "jsonrpc": "2.0",
        "id": 2,
        "method": "initialize",
        "params": {
          "protocolVersion": "2025-11-25",
          "capabilities": {},
          "clientInfo": {
            "name": "SpecExample",
            "version": "2025-11-25"
          }
        }
      },
      "expect": {
        "id": 2,
        "result": {
          "protocolVersion": "2025-11-25",
          "capabilities": {
            "tools": {}
          },
          "serverInfo": {
            "name": "local-app",
            "version": "<any>"
          },
          "instructions": "<any>"
        }
      }
    },
    {
      "send": {
        "jsonrpc": "2.0",
        "method": "notifications/initialized"
      },
      "expect": null
    },
    {
      "send": {
        "jsonrpc": "2.0",
        "id": 3,
        "method": "tools/list"
      },
      "expect": {
        "id": 3,
        "result": {
          "tools": "<array>"
        }
      }
    },
    {
      "send": {
        "jsonrpc": "2.0",
        "id": 4,
        "method": "tools/call",
        "params": {
          "name": "LocalAppList",
          "arguments": {}
        }
      },
      "expect": {
        "id": 4,
        "result": {
          "isError": false,
          "structuredContent": {
            "count": 0,
            "total": 0,
            "has_more": false,
            "apps": []
          }
        }
      }
    },
    {
      "send": {
        "jsonrpc": "2.0",
        "id": 5,
        "method": "ping"
      },
      "expect": {
        "id": 5,
        "result": {}
      }
    },
    {
      "send": {
        "jsonrpc": "2.0",
        "id": 6,
        "method": "tools/call",
        "params": {
          "name": "LocalAppScaffold",
          "arguments": {
            "name": "x"
          }
        }
      },
      "expect": {
        "id": 6,
        "error": {
          "code": -32602,
          "message": "Unknown tool: LocalAppScaffold"
        }
      }
    }
  ]
}
