              "name": "SpecExample",
              "version": "2026-07-28"
            },
            "io.modelcontextprotocol/clientCapabilities": {}
          }
        }
      },
      "expect": {
        "id": 7,
        "error": {
          "code": -32022,
          "message": "Unsupported protocol version",
          "data": {
            "supported": [
              "2026-07-28",
              "2025-11-25"
            ],
            "requested": "1900-01-01"
          }
        }
      }
    },
    {
      "send": {
        "jsonrpc": "2.0",
        "id": 8,
        "method": "ping",
        "params": {
          "_meta": {
            "io.modelcontextprotocol/protocolVersion": "2026-07-28",
            "io.modelcontextprotocol/clientInfo": {
              "name": "SpecExample",
              "version": "2026-07-28"
            },
            "io.modelcontextprotocol/clientCapabilities": {}
          }
        }
      },
      "expect": {
        "id": 8,
        "error": {
          "code": -32601
        }
      }
    },
    {
      "send": {
        "jsonrpc": "2.0",
        "id": 9,
        "method": "logging/setLevel",
        "params": {
          "level": "debug",
          "_meta": {
            "io.modelcontextprotocol/protocolVersion": "2026-07-28",
            "io.modelcontextprotocol/clientInfo": {
              "name": "SpecExample",
              "version": "2026-07-28"
            },
            "io.modelcontextprotocol/clientCapabilities": {}
          }
        }
      },
      "expect": {
        "id": 9,
        "error": {
          "code": -32601
        }
      }
    }
